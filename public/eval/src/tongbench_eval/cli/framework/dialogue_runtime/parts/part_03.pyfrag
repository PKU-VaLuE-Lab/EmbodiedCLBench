def _apply_mcp_image_compression_env(env: dict[str, str], args: argparse.Namespace) -> None:
    if not bool(getattr(args, "mcp_compress_images", False)):
        return
    env["TONGSIM_MCP_COMPRESS_IMAGES"] = "1"
    if getattr(args, "mcp_image_max_side", None) is not None:
        env["TONGSIM_MCP_IMAGE_MAX_SIDE"] = str(int(args.mcp_image_max_side))
    if getattr(args, "mcp_image_max_base64_chars", None) is not None:
        env["TONGSIM_MCP_IMAGE_MAX_BASE64_CHARS"] = str(int(args.mcp_image_max_base64_chars))
    if getattr(args, "mcp_image_jpeg_quality", None) is not None:
        env["TONGSIM_MCP_IMAGE_JPEG_QUALITY"] = str(int(args.mcp_image_jpeg_quality))


def _codex_sequence_mcp_servers(
    python_command: str,
    *,
    direct_image_input: bool = False,
    args: argparse.Namespace | None = None,
) -> dict[str, Any]:
    env = {"TONGSIM_MCP_EXPOSE_IMAGE_PATHS": "1"}
    if not direct_image_input:
        env["TONGSIM_MCP_TEXT_ONLY"] = "1"
    if args is not None:
        _apply_mcp_image_compression_env(env, args)
    return _codex_mcp_servers(
        {
            "tongsim_sequence": {
                "command": python_command,
                "args": ["/tmp_workspace/tongsim_sequence_mcp_server.py"],
                "env": env,
                "timeout": 120,
                "connect_timeout": 60,
            }
        }
    )


def _stop_bridges(processes: list[subprocess.Popen[str]], steps: list[DialogueStep]) -> None:
    for step in steps:
        if step.session is None:
            continue
        try:
            Path(step.session.bridge_dir, "STOP").write_text("stop\n", encoding="utf-8")
        except Exception:
            pass
    for proc in processes:
        try:
            proc.wait(timeout=5)
        except Exception:
            try:
                proc.terminate()
            except Exception:
                pass


def _export_step_outputs(runtime: TongSimFrameworkRuntime, steps: list[DialogueStep]) -> list[dict[str, Any]]:
    exported: list[dict[str, Any]] = []
    for step in steps:
        if step.session is None:
            continue
        result = runtime.export_outputs(step.session.session_id, step.output_dir)
        exported.append(
            {
                "index": step.index,
                "task_id": step.task_id,
                "level": step.level,
                "max_steps": step.max_steps,
                "output_dir": str(step.output_dir.resolve()),
                "score": result.get("score", {}),
                "grade": result.get("grade", {}),
            }
        )
    return exported


def _codex_outer_retry_reason(error: Any) -> str | None:
    text = str(error or "").lower()
    for reason, markers in CODEX_OUTER_RETRY_ERROR_MARKERS:
        if any(marker in text for marker in markers):
            return reason
    return None


def _archive_retry_attempt(run_dir: Path, output_root: Path, composite_task_id: str, attempt_index: int) -> Path | None:
    if not run_dir.exists():
        return None
    archive_root = output_root / "_retry_attempts"
    archive_root.mkdir(parents=True, exist_ok=True)
    archive_dir = archive_root / f"{_safe_slug(composite_task_id)}_attempt{attempt_index}_{uuid.uuid4().hex[:8]}"
    shutil.move(str(run_dir), str(archive_dir))
    return archive_dir


def _clear_existing_run_dir(run_dir: Path, output_root: Path) -> None:
    if not run_dir.exists():
        return
    resolved_run_dir = run_dir.resolve()
    resolved_output_root = output_root.resolve()
    if resolved_run_dir == resolved_output_root or resolved_output_root not in resolved_run_dir.parents:
        raise ValueError(f"Refusing to clear unexpected run directory: {resolved_run_dir}")
    shutil.rmtree(resolved_run_dir)


