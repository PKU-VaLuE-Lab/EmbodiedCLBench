def _resolve_native_mcp_python() -> str:
    configured = os.environ.get("TONGBENCH_NATIVE_MCP_PYTHON", "").strip()
    if configured:
        return configured
    bundle_root = native_bundle_root()
    bundled_python = (
        bundle_root / "hermes" / ".venv" / "bin" / "python3"
        if bundle_root is not None
        else None
    )
    if bundled_python is not None and bundled_python.is_file():
        # The native bundle owns the MCP dependencies used by all harnesses.
        # The evaluation Python may not include the `mcp` package.
        return str(bundled_python)
    return current_python()
