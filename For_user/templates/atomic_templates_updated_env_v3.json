{
  "scene": "daily_life_scene",
  "active_actions": [
    "pick_up",
    "place",
    "open",
    "close",
    "pour",
    "switch_on",
    "switch_off",
    "hang_object",
    "hand_over",
    "cut",
    "plug_in",
    "unplug",
    "drop",
    "look_at",
    "walk_to",
    "turn",
    "stand_up"
  ],
  "templates": [
    {
      "template_id": "look_at_{object}",
      "scene": "daily_life_scene",
      "action_space": [
        "look_at"
      ],
      "task_description": "Look at an object until it enters view.",
      "pre_state": [
        "exists({object})"
      ],
      "post_state": [
        "in_view({object})"
      ]
    },
    {
      "template_id": "walk_to_{object}",
      "scene": "daily_life_scene",
      "action_space": [
        "walk_to"
      ],
      "task_description": "Walk to an object that is already in view until it becomes reachable.",
      "pre_state": [
        "in_view({object})"
      ],
      "post_state": [
        "with_reach({object})"
      ]
    },
    {
      "template_id": "pick_up_{object}",
      "scene": "daily_life_scene",
      "action_space": [
        "pick_up"
      ],
      "task_description": "Pick up a pickable object that is within reach.",
      "pre_state": [
        "with_reach({object})",
        "empty"
      ],
      "post_state": [
        "holding({object})"
      ]
    },
    {
      "template_id": "place_{object}",
      "scene": "daily_life_scene",
      "action_space": [
        "place"
      ],
      "task_description": "Place a currently held object.",
