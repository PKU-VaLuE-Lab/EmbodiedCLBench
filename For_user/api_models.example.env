# Copy this file to a private location and source it before running eval scripts.
# Do not commit real API keys.

# Qwen / DashScope-compatible endpoint.
export QWEN_MODEL="qwen3.8-flash"
export QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
export QWEN_CLAUDECODE_BASE_URL="https://dashscope.aliyuncs.com/apps/anthropic"
export QWEN_API_KEY=""
# Required only when using the Claude Code harness with a third-party model
# name that Claude Code does not recognize by default.
export ANTHROPIC_CUSTOM_MODEL_OPTION="qwen3.8-flash"

# Docker images used by the four harnesses. Change these if your registry uses
# different names.
export DOCKER_IMAGE="wildclawbench-ubuntu:v1.3"
export HERMES_DOCKER_IMAGE="wildclawbench-hermes-agent:v0.5"
export DOCKER_IMAGE_CODEX="wildclawbench-codex-ubuntu:v0.0"
export DOCKER_IMAGE_CLAUDECODE="wildclawbench-claudecode-ubuntu:v0.2"

# Hugging Face token for downloading the private input and runtime datasets.
export HF_TOKEN=""
